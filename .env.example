# ───────────────────────────────────────────────────────────
# Boldfy site — env vars template
# Copia pra .env.local e preenche os valores.
# As que começam com NEXT_PUBLIC_ ficam expostas no bundle client.
# ───────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────
# Notion (blog, beta, propostas, CRM)
# ───────────────────────────────────────────────────────────

# Token de integração do Notion (Internal Integration Token)
# https://www.notion.so/profile/integrations
NOTION_API_KEY=

# Database de posts do blog
NOTION_BLOG_DATABASE_ID=

# Database de inscrições no Beta
NOTION_BETA_DB_ID=

# Database de propostas geradas pelo proposal-builder
NOTION_PROPOSTAS_DB_ID=

# CRM custom da Boldfy — 3 databases linkados (Empresas → Pessoas → Interações)
NOTION_CRM_EMPRESAS_DB_ID=
NOTION_CRM_PESSOAS_DB_ID=
NOTION_CRM_INTERACOES_DB_ID=

# ───────────────────────────────────────────────────────────
# ActiveCampaign (email automation + behavioral tracking)
# ───────────────────────────────────────────────────────────

# API server-to-server (cria/atualiza contatos, tags, custom fields)
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=

# ───────────────────────────────────────────────────────────
# Webhooks & secrets (server-only — NUNCA NEXT_PUBLIC_)
# ───────────────────────────────────────────────────────────

# Cal.com webhook signing secret — valida HMAC-SHA256 das requisições
# Configure em Cal.com → Settings → Developer → Webhooks → Secret
# Quando presente, requisições com assinatura inválida são REJEITADAS.
CAL_WEBHOOK_SECRET=

# Quando "true", recusa requisições ao webhook do Cal sem secret configurada
# (modo strict). Padrão permissivo aceita sem assinatura com warning.
# Ativar APÓS confirmar que CAL_WEBHOOK_SECRET está no Vercel + painel do Cal.
CAL_REQUIRE_SECRET=

# Secret pra assinar tokens HMAC das URLs de proposta
# Gera uma string aleatória forte: openssl rand -hex 32
# Sem isso, /proposta/[id] aceita acesso sem token (modo legado).
PROPOSAL_TOKEN_SECRET=

# ───────────────────────────────────────────────────────────
# Analytics & tracking (client-side — NEXT_PUBLIC_*)
# ───────────────────────────────────────────────────────────

# URL canônica do site — usada em metadata, sitemap, links em emails
# Em prod: https://boldfy.com.br | Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager — orquestra GA4 e LinkedIn Insight
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — fallback direto (inativo se GTM_ID presente)
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# LinkedIn Insight Tag — fallback direto (inativo se GTM_ID presente)
# Formato: número de 6-7 dígitos (Partner ID, não Account ID)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ActiveCampaign Site Tracking (VGO) — tracking comportamental
# Formato: número de 8 dígitos (Account ID do AC)
NEXT_PUBLIC_AC_ACCOUNT_ID=
